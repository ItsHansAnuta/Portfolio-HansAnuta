{
  "name": "portfolio-hans-anuta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React portfolio foundation, prepared for GitHub and Hostinger deployment.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "admin:credentials": "node scripts/admin-credentials.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
